#!/usr/bin/env bash
# jj land [<rev>] [--to <bookmark>] — forward-only trunk move with publication safety.
#
# Refuses when:
#   * the trunk bookmark is CONFLICTED (its name is then an ambiguous revset — no
#     ancestry statement about it means anything until reconciled);
#   * the move would be sideways (orphaning the old line);
#   * the target does not contain what is already published on the remote
#     (landing a line that drops published work is how local and origin diverge);
#   * the target or its unlanded ancestors contain conflicts;
#   * the landing range contains a DIVERGENT change (one change id, several visible
#     commits — trunk can end up on the twin that does not hold the work);
#   * <rev> resolves to anything but exactly one revision;
#   * a commit in the range touches a path in the repository's `land.forbidden` fileset;
#   * the repository's `land.check` command fails on the target (run last, just before the move);
#   * the trunk bookmark moved while `land.check` ran — unless the repository opted in with
#     `land.recheck-exempt` (a fileset) and the move, the automatic rebase onto it and the
#     resulting tree all stay inside that fileset (see Guard 7).
# After a land it reports every file the range added, per commit (added-then-deleted too),
# flagging secret- or scratch-shaped names and large files. Filename policy, not secret detection.
# Every check reads before the final bookmark move; concurrent writers can still change
# the repository in between. This narrows mistakes, it is not an atomic guarantee.
set -euo pipefail
ev(){ "$HOME/.local/bin/jj-agent-event" "$@" "repo=$(basename "$(jj workspace root 2>/dev/null || pwd)")" >/dev/null 2>&1 || true; }

rev="@-"; bookmark=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --to) bookmark="$2"; shift 2 ;;
        -*) echo "jj land: unknown flag '$1'" >&2; exit 2 ;;
        *) rev="$1"; shift ;;
    esac
done

count_rev() { jj log --ignore-working-copy -r "$1" --no-graph -T 'commit_id ++ "\n"' 2>/dev/null | grep -c . || true; }
one_rev()   { jj log --ignore-working-copy -r "$1" --no-graph -T 'commit_id' 2>/dev/null | head -1; }

if [[ -z "$bookmark" ]]; then
    for cand in main master trunk; do
        [[ $(count_rev "bookmarks(exact:\"$cand\")") -gt 0 ]] && { bookmark="$cand"; break; }
    done
fi
[[ -z "$bookmark" ]] && { echo "jj land: no main/master/trunk bookmark found; pass --to <bookmark>" >&2; exit 1; }

# --- Guard 0: conflicted bookmark ------------------------------------------
n=$(count_rev "bookmarks(exact:\"$bookmark\")")
if [[ "$n" -gt 1 ]]; then
    ev land-refused rule=conflicted-bookmark
    echo "jj land: REFUSED — bookmark '$bookmark' is CONFLICTED; it points at $n revisions:" >&2
    jj log --ignore-working-copy -r "bookmarks(exact:\"$bookmark\")" --no-graph \
        -T '"  " ++ commit_id.short() ++ " " ++ description.first_line() ++ "\n"' >&2
    echo "While conflicted, '$bookmark' is an ambiguous revset: no ancestry claim about it is" >&2
    echo "meaningful. Reconcile first — rebase the unpublished side onto the published one:" >&2
    echo "  jj rebase -s 'roots(bookmarks(exact:\"$bookmark\") & ~::${bookmark}@origin)' -d ${bookmark}@origin" >&2
    echo "  jj land <new-tip>" >&2
    exit 1
fi

n_target=$(count_rev "$rev")
[[ "$n_target" -eq 0 ]] && { echo "jj land: revision '$rev' does not resolve" >&2; exit 1; }
if [[ "$n_target" -gt 1 ]]; then
    ev land-refused rule=ambiguous-target
    echo "jj land: REFUSED — '$rev' resolves to $n_target revisions (a divergent change id?):" >&2
    jj log --ignore-working-copy -r "$rev" --no-graph \
        -T '"  " ++ commit_id.short() ++ " " ++ description.first_line() ++ "\n"' >&2
    echo "Read them, then land exactly one: jj land 'commit_id(\"<full id>\")'" >&2
    exit 1
fi
if [[ $(count_rev "${bookmark}@origin") -gt 1 ]]; then
    ev land-refused rule=conflicted-remote-bookmark
    echo "jj land: REFUSED — ${bookmark}@origin is conflicted; fetch and reconcile it first." >&2
    exit 1
fi
target=$(one_rev "$rev"); old=$(one_rev "$bookmark")

report_hanging() {
    local hanging
    hanging=$(jj log --ignore-working-copy \
        -r 'heads(all() & ~::bookmarks() & ~::remote_bookmarks() & ~empty())' \
        --no-graph -T 'commit_id.short() ++ " " ++ author.timestamp().format("%Y-%m-%d") ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null)
    if [[ -n "$hanging" ]]; then
        echo ""
        echo "jj land: still hanging outside any bookmark (integrate, 'jj park <name>', or report to the user):"
        echo "$hanging"
    fi
}

# --- Guard 1: never drop published work ------------------------------------
remote=$(one_rev "${bookmark}@origin" || true)
if [[ -n "$remote" && "$remote" != "$target" ]]; then
    if [[ -z "$(jj log --ignore-working-copy -r "::$target & $remote" --no-graph -T 'commit_id' 2>/dev/null)" ]]; then
        ev land-refused rule=target-missing-published-work
        echo "jj land: REFUSED — target ${target:0:12} does not contain published ${bookmark}@origin (${remote:0:12})." >&2
        echo "Landing it would diverge local '$bookmark' from the remote and drop published work:" >&2
        jj log --ignore-working-copy -r "::$remote & ~::$target & ~empty()" --no-graph \
            -T '"  " ++ commit_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null | head -10 >&2
        echo "Rebase your line onto the published head first:" >&2
        echo "  jj git fetch --remote origin" >&2
        echo "  jj rebase -s 'roots(::$target & ~::${bookmark}@origin)' -d ${bookmark}@origin" >&2
        exit 1
    fi
fi

if [[ "$target" == "$old" ]]; then
    ev land-noop
    echo "jj land: $bookmark already at ${target:0:12}."
    report_hanging
    exit 0
fi

# --- Guard 2: forward-only --------------------------------------------------
if [[ -z "$(jj log --ignore-working-copy -r "::$target & $old" --no-graph -T 'commit_id' 2>/dev/null)" ]]; then
    ev land-refused rule=sideways-or-backwards-move
    echo "jj land: REFUSED — $bookmark (${old:0:12}) is NOT an ancestor of target ${target:0:12}." >&2
    echo "A sideways move would orphan every commit only the old line reaches:" >&2
    jj log --ignore-working-copy -r "::$bookmark & ~::$target & ~empty()" --no-graph \
        -T '"  " ++ commit_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null | head -15 >&2
    echo "Rebase first, then land:" >&2
    echo "  jj rebase -s 'roots(::$target & ~::$bookmark)' -d $bookmark" >&2
    echo "Conflicts are recoverable; orphaned lines get lost." >&2
    exit 1
fi

# --- Guard 3: no divergent changes -----------------------------------------
if ! div=$(jj log --ignore-working-copy -r "($old..$target | $target) & divergent()" --no-graph \
        -T 'change_id ++ " " ++ commit_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null); then
    echo "jj land: REFUSED — could not check the range for divergent changes; inspect with jj log." >&2
    exit 1
fi
if [[ -n "$div" ]]; then
    ev land-refused rule=divergent-change
    echo "jj land: REFUSED — the landing range contains a DIVERGENT change (one change id, several" >&2
    echo "visible commits); '$bookmark' could end up on a twin that does not hold the work:" >&2
    echo "$div" | sed 's/^/  /' >&2
    echo "Read every twin first:  jj log -r 'change_id(\"<change id>\")' --stat" >&2
    echo "Then either rebuild on trunk from the twin that holds the work (when it already contains '$bookmark'):" >&2
    echo "  jj new $bookmark && jj restore --from 'commit_id(\"<twin>\")' && jj land @" >&2
    echo "or, on jj >= 0.45 and only when no bookmark reaches the twins or their descendants:" >&2
    echo "  jj converge --no-interactive -r 'change_id(\"<change id>\")'" >&2
    exit 1
fi

# --- Guard 4: no conflicted commits ----------------------------------------
if [[ -n "$(jj log --ignore-working-copy -r "($old..$target | $rev) & conflicts()" --no-graph -T 'commit_id' 2>/dev/null)" ]]; then
    ev land-refused rule=conflicted-commits
    echo "jj land: REFUSED — the target or its unlanded ancestors contain conflicts. Resolve first." >&2
    exit 1
fi

# --- Guard 5: paths this repository forbids --------------------------------
root=$(jj workspace root 2>/dev/null || pwd)
forbidden=$(jj config get land.forbidden 2>/dev/null || true)
check_forbidden() { # $1 base, $2 tip: refuse when any commit in base..tip touches land.forbidden
    [[ -z "$forbidden" ]] && return 0
    local hits="" c out
    for c in $(jj log --ignore-working-copy -r "$1..$2" --no-graph -T 'commit_id ++ "\n"' 2>/dev/null); do
        if ! out=$(cd "$root" && jj diff --ignore-working-copy -r "commit_id(\"$c\")" --summary -- "$forbidden" 2>/dev/null); then
            echo "jj land: REFUSED — land.forbidden is not a valid fileset: $forbidden" >&2
            exit 1
        fi
        [[ -n "$out" ]] && hits+=$(printf '%s\n' "$out" | sed "s/^/  ${c:0:12} /")$'\n'
    done
    if [[ -n "$hits" ]]; then
        ev land-refused rule=forbidden-path
        echo "jj land: REFUSED — the range touches paths this repository forbids (land.forbidden = $forbidden):" >&2
        printf '%s' "$hits" >&2
        echo "Remove them from every commit listed, untrack and ignore the path, then land again." >&2
        echo "Deleting in a later commit is not enough: the earlier commit still carries the file." >&2
        echo "If it held a credential, it is exposed once snapshotted — tell the user and rotate it." >&2
        exit 1
    fi
}
check_forbidden "$old" "$target"

# --- Guard 6: the repository's own check ----------------------------------
# `land.check` is a shell command (repo config, like land.forbidden). It runs from
# the workspace root with the target's full commit id appended as its argument and
# JJ_LAND_TARGET, JJ_LAND_BASE (the bookmark's current commit) and JJ_LAND_BOOKMARK
# in the environment. A non-zero exit refuses the land. There is no skip flag:
# a failing check is fixed in the change, a wrong check is fixed in the repository.
check=$(jj config get land.check 2>/dev/null || true)
if [[ -n "$check" ]]; then
    echo "jj land: running land.check on ${target:0:12} ..."
    check_log=$(mktemp "${TMPDIR:-/tmp}/jj-land-check.XXXXXX")
    set +e
    (cd "$root" && JJ_LAND_TARGET="$target" JJ_LAND_BASE="$old" JJ_LAND_BOOKMARK="$bookmark" \
        bash -c "$check"' "$@"' jj-land-check "$target") 2>&1 | tee "$check_log"
    status=${PIPESTATUS[0]}
    set -e
    if [[ "$status" -ne 0 ]]; then
        ev land-refused rule=land-check "status=$status"
        echo "" >&2
        echo "jj land: REFUSED — land.check failed on ${target:0:12} (exit $status); '$bookmark' did not move." >&2
        echo "Last lines of its output:" >&2
        tail -n 40 "$check_log" | sed 's/^/  /' >&2
        echo "Fix the cause in the change and land again. Do not bypass the check; if the check" >&2
        echo "itself is wrong, fix it in the repository (land.check = $check)." >&2
        rm -f "$check_log"
        exit 1
    fi
    rm -f "$check_log"
    checked="$target"

    # --- Guard 7: trunk moved while the check ran ---------------------------
    # The check can take minutes; another writer may have moved the bookmark meanwhile.
    # By default that refuses: the checked tree is not the tree that would land.
    # `land.recheck-exempt` (repo config, a fileset like land.forbidden) opts in to one
    # exception: when every commit that arrived on trunk touches only paths inside the
    # fileset, the landing range is rebased onto the new trunk without re-running the
    # check, provided the rebase cannot conflict and the rebased tree differs from the
    # checked tree only inside the fileset. Whatever the check could have seen outside
    # the fileset is then byte-for-byte what it did see. The bookmark is re-read after
    # each rebase; a further move repeats the whole verification (bounded), and the
    # final `jj bookmark set` itself refuses a move that is no longer forward.
    exempt=$(jj config get land.recheck-exempt 2>/dev/null || true)
    contains() { [[ -n "$(jj log --ignore-working-copy -r "::$1 & $2" --no-graph -T 'commit_id' 2>/dev/null)" ]]; }
    moved_refuse() { # $1 reason code, $2 explanation, [$3 "rebased" when the range was already rebased]
        ev land-refused rule=bookmark-moved-during-check "reason=$1"
        echo "jj land: REFUSED — '$bookmark' moved while land.check ran; rebase onto it and land again:" >&2
        echo "  ($2)" >&2
        if [[ "${3:-}" == rebased ]]; then
            echo "Your range is already rebased onto ${old:0:12}; its tip is now ${target:0:12}. Land that:" >&2
            echo "  jj land 'commit_id(\"$target\")'" >&2
        else
            echo "  jj rebase -s 'roots(::$target & ~::$bookmark)' -d $bookmark" >&2
        fi
        exit 1
    }
    skipped_moves=0; skipped_commits=0; skipped_report=""
    now=$(one_rev "$bookmark")
    while [[ "$now" != "$old" ]] && ! contains "$target" "$now"; do
        [[ -z "$exempt" ]] && moved_refuse no-exemption "land.recheck-exempt is not set for this repository"
        [[ "$skipped_moves" -ge 5 ]] && moved_refuse too-many-moves "it kept moving during 5 automatic rebases"
        [[ -z "$now" ]] && moved_refuse bookmark-gone "'$bookmark' no longer resolves to one revision"
        contains "$now" "$old" \
            || moved_refuse not-forward "'$bookmark' now points at ${now:0:12}, which does not descend from ${old:0:12}"
        [[ -n "$(jj log --ignore-working-copy -r "($old..$now) & conflicts()" --no-graph -T 'commit_id' 2>/dev/null)" ]] \
            && moved_refuse moved-conflicted "commits that arrived on '$bookmark' contain conflicts"
        # Every commit that arrived touches only exempt paths (a rename out of a
        # protected path shows its source under the complement), and so does their sum.
        outside=""
        for c in $(jj log --ignore-working-copy -r "$old..$now" --no-graph -T 'commit_id ++ "\n"' 2>/dev/null); do
            if ! out=$(cd "$root" && jj diff --ignore-working-copy -r "commit_id(\"$c\")" --name-only -- "~($exempt)" 2>/dev/null); then
                moved_refuse invalid-fileset "land.recheck-exempt is not a valid fileset: $exempt"
            fi
            [[ -n "$out" ]] && outside+=$(printf '%s\n' "$out" | head -5 | sed "s/^/    ${c:0:12} /")$'\n'
        done
        if [[ -z "$outside" ]]; then
            outside=$(cd "$root" && jj diff --ignore-working-copy --from "commit_id(\"$old\")" --to "commit_id(\"$now\")" \
                --name-only -- "~($exempt)" 2>/dev/null | head -5 | sed 's/^/    (sum) /')
        fi
        if [[ -n "$outside" ]]; then
            ev land-refused rule=bookmark-moved-during-check reason=non-exempt-path
            echo "jj land: REFUSED — '$bookmark' moved while land.check ran; rebase onto it and land again:" >&2
            echo "  (the move touches paths outside land.recheck-exempt = $exempt:)" >&2
            printf '%s\n' "$outside" >&2
            echo "  jj rebase -s 'roots(::$target & ~::$bookmark)' -d $bookmark" >&2
            exit 1
        fi
        # Only a range rooted directly on the old trunk is rebased: replacing that one
        # parent cannot drop a merge parent or a side line.
        root_parents=$(jj log --ignore-working-copy -r "roots($old..$target)" --no-graph \
            -T 'parents.map(|p| p.commit_id()).join(",") ++ "\n"' 2>/dev/null | sort -u)
        [[ "$root_parents" != "$old" ]] && moved_refuse range-shape "the landing range is not rooted solely on ${old:0:12}"
        # A path-level merge cannot conflict when the two sides touch disjoint paths and
        # neither side's path is a directory of the other's.
        ours=$(cd "$root" && jj diff --ignore-working-copy --from "commit_id(\"$old\")" --to "commit_id(\"$target\")" --name-only 2>/dev/null)
        theirs=$(cd "$root" && jj diff --ignore-working-copy --from "commit_id(\"$old\")" --to "commit_id(\"$now\")" --name-only 2>/dev/null)
        overlap=$(awk 'NR==FNR { if ($0 != "") { o[$0]=1; p=$0; while (sub(/\/[^\/]*$/, "", p)) d[p]=1 } next }
            $0 != "" { if (($0 in o) || ($0 in d)) { print; next }
                       p=$0; while (sub(/\/[^\/]*$/, "", p)) if (p in o) { print $0; break } }' \
            <(printf '%s\n' "$ours") <(printf '%s\n' "$theirs") | head -5)
        [[ -n "$overlap" ]] && moved_refuse overlapping-paths "the move and your range both touch: $(echo $overlap)"

        cid=$(jj log --ignore-working-copy -r "commit_id(\"$target\")" --no-graph -T 'change_id' 2>/dev/null)
        n_range=$(count_rev "$old..$target")
        echo "jj land: '$bookmark' moved ${old:0:12} -> ${now:0:12} during land.check; the move stays inside"
        echo "         land.recheck-exempt, so the range is rebased onto it without re-running the check."
        if ! (cd "$root" && jj rebase -s "roots($old..$target)" -d "commit_id(\"$now\")"); then
            moved_refuse rebase-failed "the automatic rebase onto ${now:0:12} failed"
        fi
        moved_old=$old; old=$now
        n_new=$(count_rev "change_id(\"$cid\") & ($now)::")
        if [[ "$n_new" -ne 1 ]]; then
            ev land-refused rule=bookmark-moved-during-check reason=rebased-target-ambiguous
            echo "jj land: REFUSED — after rebasing onto ${now:0:12}, change $cid has $n_new visible versions above it." >&2
            echo "Inspect with: jj log -r 'change_id(\"$cid\")'; then land the right one." >&2
            exit 1
        fi
        target=$(one_rev "change_id(\"$cid\") & ($now)::"); rev="commit_id(\"$target\")"
        # Re-verify everything about the rebased range before it can land.
        [[ -n "$(jj log --ignore-working-copy -r "($now..$target) & conflicts()" --no-graph -T 'commit_id' 2>/dev/null)" ]] \
            && moved_refuse rebase-conflicted "the rebased range has conflicts" rebased
        [[ -n "$(jj log --ignore-working-copy -r "($now..$target) & divergent()" --no-graph -T 'commit_id' 2>/dev/null)" ]] \
            && moved_refuse rebase-divergent "the rebased range contains a divergent change" rebased
        [[ "$(count_rev "$now..$target")" -eq "$n_range" ]] \
            || moved_refuse rebase-count "the rebased range no longer has $n_range commit(s)" rebased
        check_forbidden "$now" "$target"
        if [[ -n "$remote" ]] && ! contains "$target" "$remote"; then
            moved_refuse published "the rebased tip no longer contains ${bookmark}@origin" rebased
        fi
        differs=$(cd "$root" && jj diff --ignore-working-copy --from "commit_id(\"$checked\")" --to "commit_id(\"$target\")" \
            --name-only -- "~($exempt)" 2>/dev/null; echo "exit=$?")
        if [[ "$differs" != "exit=0" ]]; then
            moved_refuse tree-differs "the rebased tree differs from the checked tree outside the exempt fileset" rebased
        fi
        n_moved=$(count_rev "$moved_old..$now")
        skipped_moves=$((skipped_moves + 1)); skipped_commits=$((skipped_commits + n_moved))
        skipped_report+=$(jj log --ignore-working-copy -r "$moved_old..$now" --no-graph \
            -T '"    " ++ commit_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null)$'\n'
        now=$(one_rev "$bookmark")
    done
    if [[ "$skipped_moves" -gt 0 ]]; then
        ev land-recheck-skipped rule=recheck-skipped "moves=$skipped_moves" "trunk_commits=$skipped_commits"
        echo "jj land: land.check NOT re-run: it passed on ${checked:0:12}; '$bookmark' gained $skipped_commits commit(s)"
        echo "         touching only land.recheck-exempt = $exempt"
        printf '%s' "$skipped_report"
        echo "         and the rebased tip ${target:0:12} equals the checked tree outside that fileset."
    fi
    old=$now
fi

report_additions() {
    local added n c p note sz warned=0
    added=$(cd "$root" && jj log --ignore-working-copy -r "$old..$target" --no-graph \
        -T 'diff.files().filter(|f| f.status() == "added").map(|f| commit_id ++ "\t" ++ f.path()).join("\n") ++ "\n"' \
        2>/dev/null | grep . || true)
    [[ -z "$added" ]] && return 0
    n=$(printf '%s\n' "$added" | wc -l | tr -d ' ')
    echo ""
    echo "jj land: the range adds $n file(s):"
    while IFS=$'\t' read -r c p; do
        note=""
        case "${p##*/}" in
            .env.example|.env.sample|.env.template|.env.dist) ;;
            .env|.env.*|*.pem|*.key|*.p12|*.pfx|*.keystore|id_rsa*|id_dsa*|id_ecdsa*|id_ed25519*) note="secret-shaped name" ;;
            *.log|*.tmp|*.bak|*.orig|*.rej|*.swp|*~|.DS_Store|nohup.out) note="scratch-shaped name" ;;
        esac
        case "/$p" in */node_modules/*|*/__pycache__/*|*/tmp/*|*/scratch/*|*/.scratch/*) note="${note:-scratch-shaped path}" ;; esac
        if [[ -z "$(cd "$root" && jj file list --ignore-working-copy -r "commit_id(\"$target\")" -- "root:\"$p\"" 2>/dev/null)" ]]; then
            note="${note:+$note; }deleted again later in the range, still in history"
        else
            sz=$(cd "$root" && jj file show --ignore-working-copy -r "commit_id(\"$target\")" -- "root:\"$p\"" 2>/dev/null | wc -c | tr -d ' ')
            [[ "${sz:-0}" -gt 102400 ]] && note="${note:+$note; }$((sz / 1024)) KiB"
        fi
        if [[ -n "$note" ]]; then
            echo "  WARN ${c:0:12} $p  ($note)"; warned=$((warned + 1))
        else
            echo "       ${c:0:12} $p"
        fi
    done < <(printf '%s\n' "$added" | head -50)
    [[ "$n" -gt 50 ]] && echo "  ... $((n - 50)) more"
    if [[ "$warned" -gt 0 ]]; then
        ev land-warned rule=suspicious-additions "count=$warned"
        echo "Check each WARN line: litter belongs outside the checkout, and a snapshotted secret is exposed even if deleted."
    fi
    return 0
}

jj bookmark set "$bookmark" -r "$target"
n_landed=$(jj log --ignore-working-copy -r "$old..$target" --no-graph -T '"x"' 2>/dev/null | wc -c | tr -d ' ')
ev land-succeeded "commits=$n_landed"
echo "jj land: $bookmark ${old:0:12} -> ${target:0:12} (fast-forward, $n_landed commit(s))."
report_additions
jj status
report_hanging
