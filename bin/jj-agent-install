#!/usr/bin/env python3
"""Install explicit jj commands and remove retired workflow hook registrations."""
import argparse
import hashlib
import json
from pathlib import Path
import shlex
import shutil
import sys
import time
import tomllib

SOURCE = Path(__file__).resolve().parents[1]
OLD = {"jj-abandon-guard.py", "jj-world-watch.py", "jj-session-end-check.py",
       "jj-session-briefing.py", "jj-session.py", "jj-worktree.py"}


def add_selected_hooks(document, runtime, host, project=None, push_project=None):
    document = json.loads(json.dumps(document))
    events = document.setdefault("hooks", {})
    scripts = ({"WorktreeCreate": "jj-claude-worktree.py", "WorktreeRemove": "jj-claude-worktree.py"}
               if project else {"SessionStart": "jj-context.py", "PostCompact": "jj-context.py",
                                **({"PostToolUse": "jj-attribution.py"} if host == "claude" else {})})
    pre_tool = []
    if not project:
        if host == "codex" and push_project:
            pre_tool.append("jj-push-gate.py")
        pre_tool.append("jj-rm-workspace.py")
    replaced = set(scripts.values()) | set(pre_tool)
    for event, groups in list(events.items()):
        kept = []
        for group in groups:
            handlers = [h for h in group["hooks"] if not any(
                Path(t).name in replaced for t in shlex.split(h.get("command", "")))]
            if handlers:
                kept.append({**group, "hooks": handlers})
        if kept:
            events[event] = kept
        else:
            events.pop(event, None)
    for event, script in [*scripts.items(), *(("PreToolUse", script) for script in pre_tool)]:
        command = shlex.join([sys.executable, str(runtime / "hooks" / script)])
        if project:
            command += " --project " + shlex.quote(str(project))
        if script == "jj-push-gate.py":
            command += " --project " + shlex.quote(str(push_project))
        group = {"hooks": [{"type": "command", "command": command,
                             "timeout": {"jj-push-gate.py": 900, "jj-rm-workspace.py": 10}.get(
                                 script, 120 if project else 20)}]}
        if event == "PostToolUse":
            group["matcher"] = "Bash"
        if event == "PreToolUse":
            group["matcher"] = "^Bash$"
        events.setdefault(event, []).append(group)
    return document


def remove_workflow_hooks(document):
    document = json.loads(json.dumps(document))
    events = document.get("hooks", {})
    for event, groups in list(events.items()):
        kept = []
        for group in groups:
            handlers = [h for h in group["hooks"]
                        if not any(Path(t).name in OLD for t in shlex.split(h.get("command", "")))]
            if handlers:
                kept.append({**group, "hooks": handlers})
        if kept:
            events[event] = kept
        else:
            events.pop(event, None)
    if not events:
        document.pop("hooks", None)
    return document


def digest(path):
    if path.is_symlink():
        return "link:" + str(path.readlink())
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target-home", type=Path, default=Path.home())
    parser.add_argument("--project", type=Path, help="Remove retired JJ hooks from this exact project only")
    parser.add_argument("--project-only", action="store_true")
    parser.add_argument("--observational-hooks", action="store_true",
                        help="Opt in to read-only JJ context on both hosts and Claude attribution advice")
    parser.add_argument("--claude-lifecycle", action="store_true",
                        help="Opt in to owned Claude create/remove on --project after a live pilot")
    parser.add_argument("--codex-push-project", type=Path,
                        help="Scope the selected Codex push checker to this repository")
    parser.add_argument("--rollback", type=Path, help="Restore one receipt, refusing files changed since installation")
    args = parser.parse_args()
    if args.rollback:
        records = json.loads(args.rollback.read_text())
        for item in records:
            if digest(Path(item["path"])) != item["installed"]:
                raise ValueError(f"Changed since installation; manual review required: {item['path']}")
        for item in reversed(records):
            path = Path(item["path"])
            path.unlink(missing_ok=True)
            if item.get("link"):
                path.symlink_to(item["link"])
            elif item.get("backup"):
                shutil.copy2(item["backup"], path)
        print("Restored settings and executable links; releases retained. Old receipts may restore retired hooks.")
        return
    if args.project_only and not args.project:
        raise ValueError("--project-only requires --project")
    if args.claude_lifecycle and not args.project:
        raise ValueError("--claude-lifecycle requires --project")
    if args.codex_push_project:
        args.codex_push_project = args.codex_push_project.resolve(strict=True)
        if not args.observational_hooks or not (args.codex_push_project / ".jj").is_dir():
            raise ValueError("--codex-push-project requires --observational-hooks and an exact JJ root")
    files = sorted(p for directory in ["bin", "lib"] for p in (SOURCE / directory).rglob("*")
                   if p.is_file() and "__pycache__" not in p.parts)
    # Ship only reviewed implementations, never the retired Stop/world-watch guards.
    if args.observational_hooks or args.claude_lifecycle:
        files += [SOURCE / "hooks" / name for name in
                  ["jj-context.py", "jj-attribution.py", "jj-claude-worktree.py", "jj-push-gate.py",
                   "jj-rm-workspace.py"]]
        files.sort()
    stamp = hashlib.sha256(b"".join(str(p.relative_to(SOURCE)).encode() + p.read_bytes() for p in files)).hexdigest()[:16]
    home = args.target_home.expanduser().resolve()
    runtime = home / ".local/share/jj-agentic-workflow/releases" / stamp
    planned = {}
    if not args.project_only:
        for rel in [".codex/hooks.json", ".claude/settings.json"]:
            path = home / rel
            if path.exists():
                current = json.loads(path.read_text())
                cleaned = remove_workflow_hooks(current)
                if args.observational_hooks:
                    cleaned = add_selected_hooks(cleaned, runtime, "codex" if ".codex" in path.parts else "claude",
                                                 push_project=args.codex_push_project)
                if cleaned != current:
                    planned[path] = json.dumps(cleaned, indent=2) + "\n"
            elif args.observational_hooks:
                planned[path] = json.dumps(add_selected_hooks({}, runtime,
                    "codex" if ".codex" in path.parts else "claude", push_project=args.codex_push_project), indent=2) + "\n"
    if args.project:
        project = args.project.resolve(strict=True)
        if not (project / ".jj").is_dir():
            raise ValueError("Project must be the exact JJ workspace root")
        path = project / ".claude/settings.local.json"
        if path.exists():
            current = json.loads(path.read_text())
            cleaned = remove_workflow_hooks(current)
            if args.claude_lifecycle:
                cleaned = add_selected_hooks(cleaned, runtime, "claude", project=project)
            if cleaned != current:
                planned[path] = json.dumps(cleaned, indent=2) + "\n"
        elif args.claude_lifecycle:
            planned[path] = json.dumps(add_selected_hooks({}, runtime, "claude", project=project), indent=2) + "\n"
    # Validate every document before the first settings mutation.
    for path, content in planned.items():
        if path.suffix == ".json":
            json.loads(content)
        else:
            tomllib.loads(content)
    runtime.mkdir(parents=True, exist_ok=True)
    for source in files:
        target = runtime / source.relative_to(SOURCE)
        if target.exists():
            if target.read_bytes() != source.read_bytes():
                raise ValueError(f"Immutable release modified: {target}")
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, target)
    backup = home / ".local/state/jj-agent/installations" / str(time.time_ns())
    backup.mkdir(parents=True, mode=0o700)
    records = []
    def save_before(path):
        item = {"path": str(path)}
        if path.is_symlink():
            item["link"] = str(path.readlink())
        elif path.exists():
            copy = backup / str(len(records))
            shutil.copy2(path, copy)
            item["backup"] = str(copy)
        path.parent.mkdir(parents=True, exist_ok=True)
        records.append(item)
        return item
    def receipt():
        (backup / "receipt.json").write_text(json.dumps(records, indent=2) + "\n")
    for path, content in planned.items():
        if path.exists() and path.read_text() == content:
            continue
        item = save_before(path)
        temporary = path.with_name(path.name + ".jj-agent-tmp")
        temporary.write_text(content)
        temporary.chmod(0o600)
        temporary.replace(path)
        item["installed"] = digest(path)
        receipt()
    if not args.project_only:
        path = home / ".local/bin/jj-agent"
        target = runtime / "bin/jj-agent"
        if not path.is_symlink() or path.resolve() != target:
            item = save_before(path)
            path.unlink(missing_ok=True)
            path.symlink_to(target)
            item["installed"] = digest(path)
            receipt()
    receipt()
    print(json.dumps({"runtime": str(runtime), "receipt": str(backup / "receipt.json"),
                      "changed": [r["path"] for r in records],
                      "next": ("Review selected Codex hooks natively; disable unselected plugin hooks before enabling hooks."
                               if args.observational_hooks else "No global hook switch was changed.")}, indent=2))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError) as error:
        print(f"jj-agent-install: {error}", file=sys.stderr)
        sys.exit(1)
