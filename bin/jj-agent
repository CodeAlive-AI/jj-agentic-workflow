#!/usr/bin/env python3
"""Prepare, inspect and finish explicitly assigned jj workspaces."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from jj_agent import Failure, doctor, finish, prepare, survey


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-R", "--repository", default=".")
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor")
    create = commands.add_parser("prepare")
    create.add_argument("name")
    create.add_argument("-r", "--revision", required=True)
    create.add_argument("--destination")
    create.add_argument("--owner-session")
    create.add_argument("--snapshot-caller", action="store_true",
                        help="Acknowledge that JJ snapshots the exclusively owned caller")
    end = commands.add_parser("finish")
    end.add_argument("--remove", action="store_true")
    end.add_argument("--discard-path", action="append", default=[],
                     help="Explicit disposable file/directory; never infer permission to discard secrets")
    report = commands.add_parser("survey", help="Read-only: what keeps each workspace of the repository")
    report.add_argument("--idle-hours", type=float, default=24.0)
    args = parser.parse_args()
    try:
        if args.command == "prepare":
            print(prepare(args.repository, args.name, args.revision, args.destination,
                          args.owner_session, args.snapshot_caller))
        elif args.command == "survey":
            print(json.dumps(survey(args.repository, args.idle_hours), indent=2, ensure_ascii=False))
        elif args.command == "doctor":
            print(json.dumps(doctor(args.repository), indent=2))
        else:
            print(json.dumps(finish(args.repository, args.remove, args.discard_path), indent=2))
    except (Failure, OSError, ValueError) as error:
        print(f"jj-agent: {error}", file=sys.stderr)
        return 1
    return 0


sys.exit(main())
